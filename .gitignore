# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
venv*/.venv_ai/
.env

# Model binarios grandes (no guardar en git, usar .safetensors.part.* + reassemble.sh)
model/*.safetensors
!model/model.safetensors.part.*
!model/reassemble.sh
!model/config.json
!model/tokenizer.json
!model/tokenizer_config.json

# Outputs de experimentos
ai_experiment/
*.safetensors.backup*
*.edits.json
*_log_*.json
*_evaluation*.json
*_steering.json
*_anti_loop*.json
*_idk50m*.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
# Variantes IDK50M (demasiado grandes para git, regenerar con scripts/)
model/idk50m_*.safetensors

# Resultados de experimentos (excepto los que se quieren versionar)
!ai_experiment/idk50m_variants_evaluation.json

# Venv (no commitear)
.venv_ai/

# Variantes generadas (demasiado grandes, regenerar con scripts/)
model/variants/

# Archivos de edición iterativa viejos
model/anti_loop_analysis.json
model/iterative_edit_log_fast.json
model/model_iter.safetensors.part.*
model/reassemble_iter.sh
